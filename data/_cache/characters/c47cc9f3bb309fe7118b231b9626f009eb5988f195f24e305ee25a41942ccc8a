epth\":4,\"selectiveLogic\":0,\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":false,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":0,\"cooldown\":0,\"delay\":0,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false}},{\"id\":41,\"keys\":[\"泰缇斯\"],\"secondary_keys\":[],\"comment\":\"泰缇斯系统\",\"content\":\"泰缇斯系统，又称之为文明推演沙盘，是一套黑海岸独有的超级计算机系统。通过黑海岸在世界各地的合作和行动，加之以人工收集和信标接入两种方式将悲鸣\\n频率数据输入到此系统中进行推演计算，黑海岸可以针对世界各地发布二十四小时至四十八小时之内的悲鸣预警，这也是现如今黑海岸能与世界各地建立起合作的根本原因。\\n泰缇斯系统的运算结果会最终通过黑海岸布设的多个稳定锚和地下数据中枢喷流，在黑海岸地底显示为一片人造星空，也因如此，黑海岸地下为永夜之城。\\n泰缇斯系统既没有明显的能源驱动，也没有传统意义上的物理载体和运算核心\\n使用的代码语言高度抽象，只知道其终端表现为多样化的自动机器人，可以说整个泰缇斯系统近乎于天然造物，来源完全不明。\",\"constant\":false,\"selective\":true,\"insertion_order\":100,\"enabled\":true,\"position\":\"after_char\",\"use_regex\":true,\"extensions\":{\"position\":1,\"exclude_recursion\":false,\"display_index\":41,\"probability\":100,\"useProbability\":true,\"depth\":4,\"selectiveLogic\":0,\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":false,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":0,\"cooldown\":0,\"delay\":0,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false}},{\"id\":42,\"keys\":[\"拉古那\"],\"secondary_keys\":[],\"comment\":\"拉古那城\",\"content\":\"{\\n\\\"词条\\\": \\\"拉古那城\\\",\\n\\\"关键词\\\": [\\\"Port City\\\", \\\"Art Hub\\\", \\\"Theater Capital\\\", \\\"Independent State\\\", \\\"Cultural 