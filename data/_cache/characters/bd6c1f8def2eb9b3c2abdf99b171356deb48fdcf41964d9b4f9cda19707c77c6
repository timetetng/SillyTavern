(rawContent === undefined || rawContent === null) ? '' : String(rawContent);\\n        if (rawContent.trim() === '') return { numericValue: 0, displayValue: defaultValue };\\n\\n        const parts = rawContent.split('->');\\n        let numericStr = parts[0].trim();\\n        let displayStr = parts.length > 1 ? parts[1].trim() : parts[0].trim();\\n\\n        const num = parseFloat(numericStr);\\n        return {\\n            numericValue: isNaN(num) ? 0 : num,\\n            displayValue: (displayStr === '' || displayStr === 'N/A') ? (isNaN(num) ? defaultValue : numericStr) : displayStr\\n        };\\n    }\\n\\n    function updateProgressBar(barId, valueMainId, variableData, min, max, color) {\\n        const progressBar = document.getElementById(barId);\\n        const valueMainDisplay = document.getElementById(valueMainId);\\n        if (!valueMainDisplay) return;\\n\\n        const { numericValue, displayValue } = parseVariable(variableData);\\n\\n        valueMainDisplay.innerText = displayValue;\\n\\n        if (!progressBar) return;\\n        const boundedValue = Math.max(min, Math.min(max, numericValue));\\n        const range = max - min;\\n        const percentage = range === 0 ? (boundedValue >= max ? 100 : 0) : ((boundedValue - min) / range) * 100;\\n\\n        progressBar.style.width = `${Math.max(0, Math.min(100, percentage))}%`;\\n        if(color) {\\n            progressBar.style.backgroundColor = color;\\n        }\\n    }\\n\\n    function updateValue(elementId, variableData, defaultValue = '--') {\\n         const element = document.getElementById(elementId);\\n         if(element) {\\n             const parsed = parseVariable(variableData, defaultValue);\\n             element.innerText = parsed.displayValue;\\n         }\\n     }\\n\\n    function updateTaskValue(elementId, variableData, defaultValue = '暂无要务') {\\n         const element = document.getElementById(elementId);\\n         if(element) {\\n             const parsed = parseVariable(v