yId('task-toggle');\\n\\n        if(mainView.classList.contains('hidden')){\\n            mainView.classList.remove('hidden');\\n            taskView.classList.add('hidden');\\n            title.innerText = '塞西莉亚小镇纪事';\\n            taskToggle.innerText = '📜';\\n        } else {\\n            mainView.classList.add('hidden');\\n            taskView.classList.remove('hidden');\\n            title.innerText = '小镇要务';\\n            taskToggle.innerText = '↩';\\n            taskToggle.classList.remove('has-notification');\\n        }\\n    }\\n\\n    document.addEventListener('DOMContentLoaded', () => {\\n        document.body.style.opacity = '0';\\n        document.getElementById('theme-toggle').addEventListener('click', toggleTheme);\\n        document.getElementById('task-toggle').addEventListener('click', toggleView);\\n        initDisplay();\\n    });\\n</script>\\n</body>\\n</html>\\n```\",\"trimStrings\":[],\"placement\":[2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":5},{\"id\":\"8f0d51d4-f678-4773-bc7b-1adbd762ad95\",\"scriptName\":\"隐藏状态栏\",\"findRegex\":\"<StatusPlaceHolderImpl/>\",\"replaceString\":\"\",\"trimStrings\":[],\"placement\":[2],\"disabled\":false,\"markdownOnly\":false,\"promptOnly\":true,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":null},{\"id\":\"915653a7-0c2e-46dd-abff-f1355af1d9b4\",\"scriptName\":\"[不发送]去除变量更新\",\"disabled\":false,\"runOnEdit\":false,\"findRegex\":\"/<update(?:variable)?>(?:(?!.*<\\\\/update(?:variable)?>).*$|.*<\\\\/update(?:variable)?>)/gsi\",\"replaceString\":\"\",\"trimStrings\":[],\"placement\":[2],\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":null,\"markdownOnly\":false,\"promptOnly\":true},{\"id\":\"02563595-4c66-4437-854f-85e38a0ffe41\",\"scriptName\":\"[美化]变量更新中\",\"disabled\":false,\"runOnEdit\":false,\"findRegex\":\"/<update(?:variable)?>(?!.*<\\\\/update(?:variable)?>)\\\\s*(.*)\\\\s*$/gsi\"