er\\\", \\\"Clerics' Office\\\", \\\"Sculptures\\\", \\\"Watchful Guards\\\"],\\n      \\\"描述\\\": \\\"隐海修会的教士们办公的塔楼。室内两侧皆伫立着巨大的雕塑,宛若无声的卫兵，注视着每一个来访者。\\\"\\n    },\\n      \\\"水星天教堂\\\": {\\n      \\\"描述\\\": \\\"拉古那城中用以瞻仰岁主雕像的神圣建筑，包含上下两层，被统称为“水星天教堂”，亦是隐海修会之所在\\\"\\n    },\\n    \\\"修会花园\\\": {\\n      \\\"关键词\\\": [\\\"Society Garden\\\", \\\"Water Garden\\\", \\\"Confessional\\\", \\\"Hidden Secret\\\"],\\n      \\\"描述\\\": \\\"水星天圣堂背后存在一小片水上花园，花园尽头的忏悔室中，说出要惭悔的事物后可以搭乘电梯来到'拂风水畔'\\\"\\n    }\\n  },\\n  \\\"意义\\\": {\\n    \\\"宗教\\\": \\\"岁主信仰的中心，拉古那的精神象征\\\",\\n    \\\"文化\\\": \\\"体现了拉古那的宗教文化和建筑艺术\\\",\\n    \\\"社会\\\": \\\"宗教活动和社会生活的交汇点\\\"\\n  }\\n}\\n\",\"constant\":false,\"selective\":true,\"insertion_order\":100,\"enabled\":true,\"position\":\"after_char\",\"use_regex\":true,\"extensions\":{\"position\":3,\"exclude_recursion\":false,\"display_index\":80,\"probability\":100,\"useProbability\":true,\"depth\":4,\"selectiveLogic\":0,\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":false,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":0,\"cooldown\":0,\"delay\":0}},{\"id\":81,\"keys\":[\"金库\"],\"secondary_keys\":[],\"comment\":\"埃弗拉德金库\",\"content\":\"{\\n  \\\"词条\\\": \\\"埃弗拉德金库\\\",\\n  \\\"关键词\\\": [\\\"Everard Vault\\\", \\\"Motari Family\\\", \\\"Safekeeping\\\", \\\"Collection Valuation\\\", \\\"Collection Acquisition\\\", \\\"Cloud Sea Train\\\", \\\"Echo Security\\\"],\\n  \\\"性质\\\": \\\"莫塔里家族在城外修建的金库，用于存放重要物品、家族藏品，并提供估值和收购服务\\\",\\n  \\\"所有者\\\": \\\"莫塔里家族\\\",\\n  \\\"功能区\\\": {\\n    \\\"地上\\\": \\\"金库管理区\\\",\\n    \\\"地下\\\": \\\"金库藏馆区\\\"\\n  },\\n  \\\"业务\\\": {\\n    \\\"存储\\\": \\\"保管重要物品\\\",\\n    \\\"估值\\\": \\\"藏品估值\\\",\\n    \\\"收购\\\": \\\"收购有价值的藏品\\\"\\n  },\\n  \\\"交通\\\": {\\n    \\\"申请\\\": \\\"通过拉古那城内的埃弗拉德银行申请办理存储业务\\\",\\n    \\\"运输\\\": \\\"特殊的云海列车会将藏品押运至埃