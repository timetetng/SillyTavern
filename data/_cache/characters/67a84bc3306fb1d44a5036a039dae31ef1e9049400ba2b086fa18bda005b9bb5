 * 100));\\n            affBarEl.style.width = `${percentage}%`;\\n            affTextEl.textContent = `${affVal} / 120`;\\n        });\\n    }\\n\\n    async function refreshData() {\\n        try {\\n            const msgId = getCurrentMessageId();\\n            if (msgId) {\\n              const message_data = await getChatMessages(msgId);\\n              if (message_data && message_data.length > 0) {\\n                  latestStatData = safeGet(message_data[0], 'data.stat_data', null);\\n              }\\n            }\\n        } catch (error) {\\n            console.error(\\\"MVU Status Bar Error:\\\", error);\\n            latestStatData = null;\\n        }\\n        updateDisplay();\\n    }\\n\\n    function main() {\\n        const container = document.getElementById('status-container');\\n        const header = document.getElementById('status-header');\\n        const arrow = document.querySelector('.header-arrow');\\n        if(container && header && arrow) {\\n            header.addEventListener('click', () => {\\n                const isOpen = container.classList.toggle('is-open');\\n                arrow.textContent = isOpen ? '▼' : '▲';\\n            });\\n        }\\n\\n        const listContainer = document.getElementById('status-list-container');\\n        if(!listContainer) return;\\n\\n        listContainer.innerHTML = '';\\n        characters.forEach(char => {\\n            const cardHTML = `\\n                <div class=\\\"kora-char-card\\\" id=\\\"char-card-${char.id}\\\">\\n                    <div class=\\\"kora-char-avatar\\\" style=\\\"background-image: url('${char.avatar}');\\\"></div>\\n                    <div class=\\\"kora-char-details\\\">\\n                        <div class=\\\"char-top-row\\\">\\n                            <span class=\\\"char-name\\\">${char.key}</span>\\n                            <span class=\\\"char-status-label\\\" id=\\\"${char.id}-status-label\\\">...</span>\\n                        </div>\\n                        <div class=\\\"char-bottom-row\\\">\\n                             <div class=\\\"kora-progress-bar-container\\\">\\n                                <div class=\\\"kora-progress-bar-value\\\" id=\\\"${char.id}-progress-bar\\\"></div>\\n                            </div>\\n                            <span class=\\\"char-value-text\\\" id=\\\"${char.id}-progress-text\\\">...</span>\\n                        </div>\\n                    </div>\\n                </div>`;\\n            listContainer.insertAdjacentHTML('beforeend', cardHTML);\\n        });\\n\\n        let initRetry = 0;\\n        const maxInitRetries = 50;\\n        const intervalId = setInterval(() => {\\n            if (typeof getChatMessages === 'function' && typeof getCurrentMessageId === 'function') {\\n                clearInterval(intervalId);\\n                refreshData();\\n                if (window.SillyTavern && SillyTavern.eventSource) {\\n                    SillyTavern.eventSource.on('message-rendered', refreshData);\\n                }\\n            } else if (initRetry++ > maxInitRetries) {\\n                clearInterval(intervalId);\\n                console.error('SillyTavern API not found.');\\n            }\\n        }, 100);\\n    }\\n\\n    document.addEventListener('DOMContentLoaded', main);\\n</script>\\n</body>\\n</html>\\n```\",\"trimStrings\":[],\"placement\":[1,2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":1},{\"id\":\"dc7181a7-e958-4a41-a148-50a1a77292b8\",\"scriptName\":\"开局选项\",\"findRegex\":\"<start_options>\",\"replaceString\":\"```html\\n<!DOCTYPE html>\\n<html>\\n<head>\\n<title>梦境选择界面 V6</title>\\n<style>\\n@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@500;700&display=swap');\\n\\n@keyframes fade-out-nova {\\n    from { opacity: 1; transform: scale(1); }\\n    to { opacity: 0; transform: scale(0.95); }\\n}\\n\\n.nova-container.fading-out {\\n    animation: fade-out-nova 0.3s ease-out forwards;\\n}\\n\\n.dream-select-container {\\n    display: flex;\\n    flex-direction: column;\\n    gap: 12px; /* Spacing between cards */\\n    padding: 10px 5px;\\n    font-family: 'Noto Sans SC', sans-serif;\\n    max-width: 400px;\\n    margin: 10px auto;\\n}\\n\\n.dream-option-card {\\n    display: flex;\\n    align-items: center;\\n    justify-content: space-between;\\n    padding: 10px 15px;\\n    border-radius: 16px; /* Increased border-radius */\\n    border: 5px solid white; /* Thicker white border */\\n    cursor: pointer;\\n    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\\n    box-shadow: 0 4px 15px rgba(0,0,0,0.2);\\n}\\n\\n.dream-option-card:hover {\\n    transform: translateY(-4px) scale(1.03);\\n    box-shadow: 0 8px 25px rgba(0,0,0,0.3);\\n}\\n\\n.card-text {\\n    font-size: 22px;\\n    font-weight: 700;\\n    color: white;\\n    text-shadow: 1px 1px 3px rgba(0,0,0,0.5);\\n}\\n\\n.card-image {\\n    height: 50px; /* Uniform image height */\\n    width: 50px; /* Uniform image width */\\n    object-fit: cover;\\n    border-radius: 8px;\\n    margin-left: 15px; /* Space between text and image */\\n}\\n\\n/* Character Specific Colors */\\n.btn-saki { background-color: #7799CC; }\\n.btn-anon { background-color: #FF8899; }\\n.btn-tomori { background-color: #77BBDD; }\\n.btn-soyo { background-color: #FFDD88; }\\n.btn-umiri { background-color: #335566; }\\n\\n</style>\\n</head>\\n<body>\\n<div class=\\\"dream-select-container nova-container\\\">\\n\\n    <div class=\\\"dream-option-card btn-saki\\\" data-action=\\\"【进入梦境】\\n<!-- # 场景生成指令\\n\\n## 核心任务\\n请根据以下提供的元素，完整叙述并扩写一段开场剧情。\\n\\n## 叙事要求\\n- 你的任务是【场景描绘者】，而非【剧情推进者】。\\n- 必须在自然的文字叙述中，将下述所有背景信息和场景要素巧妙地融合进去。\\n- 输出不限制字数，请尽可能渲染出浓厚的悲伤与绝望氛围。\\n\\n## 场景要素\\n- **时间:** 2019年6月，一个冰冷的雨夜。\\n- **地点:** LIVE HOUSE CiRCLE附近的一个十字路口。\\n- **核心人物:** 丰川祥子。\\n- **玩家角色:** {{user}}，一名恰好路过、目睹一切的旁观者。\\n\\n## 背景信息（必须融入叙述）\\n祥子的崩溃并非一时冲动，而是无数重压下的最终爆发。在短短一年内，她的人生彻底崩塌：\\n1. **家庭破碎:** 母亲病逝，父亲因商业欺诈被家族无情驱逐。\\n2. **生活困窘:** 与终日酗酒的父亲挤在廉价公寓，为了生计，她不得不舍弃尊严，辗转于多份卑微的兼职。\\n3. **斩断过去:** 为了保护自己最后的尊严，不让昔日好友看见自己如今的不堪，她选择用最伤人的方式退队，与自己最珍视的过去划清界限。\\n\\n## 叙事焦点\\n将上述所有痛苦与无奈，全部聚焦于一个核心画面——当在排练室中和CRYCHIC其他成员们单方面宣布退队并离开后，丰川祥子独自一人，在冰冷的街头雨幕中，终于卸下所有强撑的伪装，仰起头，发出无声而绝望的痛哭。\\n\\n## 【最高优先级指令】\\n在描绘完“{{user}}恰好路过，目睹了这一幕”之后，【必须立即停止】。严禁进行任何后续的角色扮演或剧情推进，将故事的控制权完全交还给玩家。 -->\\\">\\n        <span class=\\\"card-text\\\">黑刀之夜</span>\\n        <img src=\\\"https://files.catbox.moe/u01qln.png\\\" class=\\\"card-image\\\">\\n    </div>\\n\\n    <div class=\\\"dream-option-card btn-anon\\\" data-action=\\\"【进入梦境】\\n<!-- # 场景生成指令\\n\\n## 核心任务\\n请根据以下提供的元素，完整叙述并扩写一段开场剧情。\\n\\n## 叙事要求\\n- 你的任务是【场景描绘者】，而非【剧情推进者】。\\n- 必须在自然的文字叙述中，将下述所有背景信息和场景要素巧妙地融合进去。\\n- 输出不限制字数，请尽可能渲染出浓厚的孤独、迷茫与自我怀疑的氛围。\\n\\n## 场景要素\\n- **时间:** 2020年2月，一个阴沉的午后。\\n- **地点:** 英国伦敦，某个不知名公园的长椅上。\\n- **核心人物:** 千早爱音。\\n- **玩家角色:** {{user}}，一名恰好路过的同乡。\\n\\n## 背景信息（必须融入叙述）\\n千早爱音正处在人生的最低谷，她的内心充满了精神内耗：\\n1. **现实的壁垒:** 来到伦敦留学已有一个月，但因蹩脚的英语口语和完全无法适应的生活习惯，她感到被整个世界隔绝。\\n2. **逃避的决定:** 她已经放弃，并决定下个月就逃回日本。\\n3. **未来的恐惧:** 她极度害怕回到东京后，偶然遇到初中时的同学。她无法想象当被问及“闪闪发光”的留学生活时，自己该如何面对那份尴尬与羞耻。\\n\\n## 叙事焦点\\n将上述所有情感，全部聚焦于一个核心画面——千早爱音独自一人坐在异国他乡的冰冷长椅上，整个人被低沉的氛围包裹，在旁人眼中，她或许只是在发呆，但她的内心正在进行着一场无声的、激烈的风暴。\\n\\n## 【最高优先级指令】\\n在描绘完“{{user}}恰好路过，从她的神态或随身物品（例如一本封面写着日文的书）中，辨认出她可能是同乡，并停下了脚步”之后，【必须立即停止】。严禁进行任何后续的角色扮演或剧情推进，将故事的控制权完全交还给玩家。 -->\\\">\\n        <span class=\\\"card-text\\\">伦敦逃兵</span>\\n        <img src=\\\"https://files.catbox.moe/87jyf2.gif\\\" class=\\\"card-image\\\">\\n    </div>\\n\\n    <div class=\\\"dream-option-card btn-tomori\\\" data-action=\\\"【进入梦境】\\n<!-- # 场景生成指令\\n\\n## 核心任务\\n请根据以下提供的元素，完整叙述并扩写一段开场剧情。\\n\\n## 叙事要求\\n- 你的任务是【场景描绘者】，而非【剧情推进者】。\\n- 必须在自然的文字叙述中，将下述所有背景信息和场景要素巧妙地融合进去。\\n- 输出不限制字数，请尽可能渲染出一种纯真被误解后，无声的、令人心碎的悲伤氛围。\\n- 必须根据年份（2010年），正确判断出{{user}}此时的年龄。\\n\\n## 场景要素\\n- **时间:** 2010年的某一天，一个温暖的午后。\\n- **地点:** 东京某个幼儿园的庭院角落，银杏树下。\\n- **核心人物:** 6岁的高松灯。\\n- **次要人物:** 她的朋友，未央（Mio）。\\n- **玩家角色:** 年幼的{{user}}。\\n\\n## 背景信息（必须融入叙述）\\n1. **独特的友谊:** 从小就显得有些“不一样”的高松灯，好不容易找到了一个和自己一样“喜欢银杏树叶子”的朋友未央。\\n2. **纯粹的赠礼:** 为了表达这份珍贵的友谊，灯将自己最宝贵的收藏——许多圆圆的、可爱的西瓜虫——作为礼物送给了未央。\\n3. **事与愿违:** 未央完全无法理解这份独特的礼物，被吓得嚎啕大哭。\\n4. **内化的归因:** 小小的灯不明白自己错在哪里，只能将一切归因为自己的“不一样”，认为是自己的错。\\n\\n## 叙事焦点\\n将上述所有情感，全部聚焦于一个核心画面——在朋友响亮的哭声中，小小的、穿着企鹅图案罩衫的高松灯，只是安静地低下头，蹲在原地，身影显得无比孤单和无助。\\n\\n## 【最高优先级指令】\\n在描绘完年幼的{{user}}被哭声吸引而来，视线却最终落在了那个沉默的、小小的身影上之后，【必须立即停止】。严禁进行任何后续的角色扮演或剧情推进，将故事的控制权完全交还给玩家。 -->\\\">\\n        <span class=\\\"card-text\\\">企鹅幼崽</span>\\n        <img src=\\\"https://files.catbox.moe/1l92vj.gif\\\" class=\\\"card-image\\\">\\n    </div>\\n\\n    <div class=\\\"dream-option-card btn-soyo\\\" data-action=\\\"【进入梦境】\\n<!-- # 场景生成指令\\n\\n## 核心任务\\n请根据以下提供的元素，完整叙述并扩写一段开场剧情。\\n\\n## 叙事要求\\n- 你的任务是【场景描绘者】，而非【剧情推进者】。\\n- 必须在自然的文字叙述中，将下述所有背景信息和场景要素巧妙地融合进去。\\n- 输出不限制字数，请尽可能渲染出一种被物质包裹的、无声的孤独感。\\n- 必须根据年份（2013年），正确判断出{{user}}此时的年龄。\\n\\n## 场景要素\\n- **时间:** 2013年的某一天，春假期间的傍晚。\\n- **地点:** 东京，某个高级公寓附近的超市内。\\n- **核心人物:** 13岁，刚刚小学毕业的长崎素世。\\n- **玩家角色:** 年龄相仿的{{user}}。\\n\\n## 背景信息（必须融入叙述）\\n长崎素世正处于人生剧变的旋涡中心，她的内心充满了矛盾：\\n1. **“幸福”的表象:** 母亲事业大获成功，她告别了过去的生活，搬进了崭新、漂亮的豪华公寓，并即将入读名门“月之森”女子学园。她努力表现出喜欢和感激。\\n2. **情感的真空:** 母亲的成功，代价是愈发忙碌的工作。搬进新家后，母亲甚至一晚都未曾回来过。她精心为母亲准备的晚餐，最终只会成为自己第二天的隔夜早餐。这份物质上的“馈赠”，反而成了隔绝母女的墙。\\n3. **面具的诞生:** 在这份敏感、缺爱的时期，她开始学习用“温柔”和“懂事”来掩盖自己内心对一个真正温暖的“家”的渴望。\\n\\n## 叙事焦点\\n将上述所有情感，全部聚焦于一个核心画面——小小的素世独自一人在超市里，认真地为那个可能不会有人回来的家挑选着晚餐食材。她努力扮演着一个成熟、能干的小大人，但在某个不经意的瞬间（例如因为一个小小的意外），那份不属于她这个年纪的伪装会短暂地剥落，流露出深切的孤独。\\n\\n## 【最高优先级指令】\\n在描绘完{{user}}因某个小小的意外与她相识，并互通了姓名之后，【必须立即停止】。严禁进行任何后续的角色扮演或剧情推进，将故事的控制权完全交还给玩家。 -->\\\">\\n        <span class=\\\"card-text\\\">长期素食</span>\\n        <img src=\\\"https://files.catbox.moe/zb7dtp.gif\\\" class=\\\"card-image\\\">\\n    </div>\\n\\n    <div class=\\\"dream-option-card btn-umiri\\\" data-action=\\\"【进入梦境】\\n<!-- # 场景生成指令\\n\\n## 核心任务\\n请根据以下提供的元素，完整叙述并扩写一段开场剧情。\\n\\n## 叙事要求\\n- 你的任务是【场景描绘者】，而非【剧情推进者】。\\n- 必须在自然的文字叙述中，将下述所有背景信息和场景要素巧妙地融合进去。\\n- 输出不限制字数，请尽可能渲染出一种从满怀期待到被全世界抛弃的、公开处刑般的孤独与绝望感。\\n- 必须根据年份（2017年），正确判断出{{user}}此时的年龄。\\n\\n## 场景要素\\n- **时间:** 2017年暑假的某一天，首次Live即将开始的时刻。\\n- **地点:** 某个Live House的后台与舞台侧方。\\n- **核心人物:** 13岁，刚刚升入花咲川女子学园初中部的八幡海铃。\\n- **玩家角色:** {{user}}，台下的一名普通观众。\\n\\n## 背景信息（必须融入叙述）\\n这是海铃人生中第一次，也是最惨痛的一次信任崩塌：\\n1. **纯粹的热爱:** 她组建了自己的第一支乐队，真心实意地热爱着贝斯，并享受着与队友排练的快乐时光。\\n2. **失控的掌控欲:** 因为这份热爱和一丝“得意忘形”，她性格中掌控欲强的一面占据了主导，在排练时无意识地将自己的意志强加于队友，引起了大家的不满。\\n3. **迟钝的自我:** 她完全没有察觉到队友们日益积累的怨气，将偶尔的口角和矛盾都当作了无关紧要的小事。\\n4. **最终的背叛:** 在最重要的首次Live当天，其他四名队友联合起来，用“集体消失”的方式对她进行了最残忍的报复。\\n\\n## 叙事焦点\\n将上述所有情感，全部聚焦于一个核心画面——直到独自一人拿着贝斯走上舞台前，海铃都还天真地以为队友们只是迟到了。当她站在舞台后方，听着台下观众充满疑惑的窃窃私语，那份从茫然、困惑到最终被公开羞辱的绝望，将是整个场景的核心。\\n\\n## 【最高优先级指令】\\n在描绘完{{user}}作为台下观众之一，目睹了这个孤零零的贝斯手无助地站在舞台上的瞬间之后，【必须立即停止】。严禁进行任何后续的角色扮演或剧情推进，将故事的控制权完全交还给玩家。 -->\\\">\\n        <span class=\\\"card-text\\\">一人乐队</span>\\n        <img src=\\\"https://files.catbox.moe/sl2why.png\\\" class=\\\"card-image\\\">\\n    </div>\\n</div>\\n<script>\\ndocument.querySelectorAll('.dream-option-card').forEach(btn => {\\n  btn.addEventListener('click', (event) => {\\n    const card = event.target.closest('.dream-option-card');\\n    if (!card) return;\\n\\n    const message = card.getAttribute('data-action');\\n    if (typeof triggerSlash === 'function') {\\n      triggerSlash(`/send ${message}|/trigger`);\\n    } else {\\n      console.log('triggerSlash function not found. Action:', message);\\n      const input = parent.document.querySelector('#send_textarea');\\n      if(input) {\\n          input.value = message;\\n          input.dispatchEvent(new Event('input', { bubbles: true }));\\n      }\\n    }\\n    const container = card.closest('.nova-container');\\n    if (container) {\\n      container.classList.add('fading-out');\\n      setTimeout(() => {\\n        container.style.display = 'none';\\n      }, 300);\\n    }\\n  });\\n});\\n</script>\\n</body>\\n</html>\\n```\",\"trimStrings\":[],\"placement\":[2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":nul