\n        transform: scale(0.98);\\n      }\\n    }\\n    \\n    /* 打印样式优化 */\\n    @media print {\\n      body {\\n        background: white;\\n      }\\n      \\n      .app-container {\\n        box-shadow: none;\\n        border: 1px solid #ddd;\\n      }\\n      \\n      .modal-overlay,\\n      .multi-select-modal,\\n      .notification,\\n      .item-tooltip {\\n        display: none !important;\\n      }\\n    }\\n  </style>\\n\\n  <script type=\\\"module\\\">\\n    // 全局状态\\n    let mvuAvailable = false;\\n    let currentTab = 'inventory';\\n    let currentTooltip = null;\\n    let characterCollapsed = false;\\n    let panelCollapsed = false;\\n    let selectedShopItems = {}; // 选中的商品\\n    let selectedInventoryItems = {}; // 选中的物品\\n    \\n    \\n    // 显示通知\\n    function showNotification(message, type = 'success') {\\n      const notification = document.getElementById('notification');\\n      notification.textContent = message;\\n      notification.className = `notification show ${type}`;\\n      \\n      setTimeout(() => {\\n        notification.classList.remove('show');\\n      }, 3000);\\n    }\\n\\n    // 切换选项卡\\n    window.switchTab = function(tabName) {\\n      currentTab = tabName;\\n      \\n      // 更新选项卡状态\\n      document.querySelectorAll('.nav-tab').forEach(tab => {\\n        tab.classList.toggle('active', tab.dataset.tab === tabName);\\n      });\\n      \\n      // 更新内容显示\\n      document.querySelectorAll('.tab-content').forEach(content => {\\n        content.classList.toggle('active', content.id === `${tabName}-content`);\\n      });\\n    };\\n    \\n    // 切换角色卡片折叠状态\\n    window.toggleCharacterCard = function() {\\n      characterCollapsed = !characterCollapsed;\\n      const card = document.querySelector('.character-card');\\n      if (characterCollapsed) {\\n        card.classList.add('collapsed');\\n      } else {\\n        card.classList.remove('collapsed');\\n      }\\n    };\\n    \\n    // 切换内容面板折叠状态\\n    window.toggleContentPanel = function() {\\n      panelCollapsed = !panelCollapsed;\\n      const panel = document.querySelector('.content-panel');\\n      if (panelCollapsed) {\\n        panel.classList.add('collapsed');\\n      } else {\\n        panel.classList.remove('collapsed');\\n      }\\n    };\\n\\n    // 显示物品详情\\n    window.showItemTooltip = function(event, itemName, category) {\\n      event.stopPropagation();\\n      \\n      if (!mvuAvailable) return;\\n      \\n      // 使用 getAllVariables() 获取完整变量对象\\n      const all_variables = getAllVariables();\\n      const item = _.get(all_variables, `stat_data.物品栏.${category}.${itemName}`);\\n      \\n      if (!item) return;\\n      \\n      const getValue = (val) => Array.isArray(val) ? val[0] : val;\\n      \\n      const tooltip = document.getElementById('item-tooltip');\\n      tooltip.innerHTML = `\\n        <div style=\\\"font-weight: 700; color: var(--cyan-gray); margin-bottom: 10px; font-size: 15px;\\\">${itemName}</div>\\n        <div style=\\\"font-size: 12px; color: var(--text-secondary); line-height: 1.6;\\\">\\n          <div>📦 数量: ${getValue(item.数量)}</div>\\n          ${item.品质 ? `<div>✨ 品质: ${getValue(item.品质)}</div>` : ''}\\n          ${item.效果 ? `<div>💫 效果: ${getValue(item.效果)}</div>` : ''}\\n          ${item.描述 ? `<div>📝 描述: ${getValue(item.描述)}</div>` : ''}\\n        </div>\\n        ${category === '消耗品' && getValue(item.数量) > 0 ? `\\n          <div style=\\\"margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-color);\\\">\\n            <button style=\\\"width: 100%; padding: 8px; background: linear-gradient(135deg, var(--cyan-gray) 0%, var(--light-green) 100%); color: white; border: none; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;\\\" onclick=\\\"handleItemUse('${category}', '${itemName}')\\\">使用物品</button>\\n          </div>\\n        ` : ''}\\n      `;\\n      \\n      // 定位提示框\\n      const rect = event.target.getBoundingClientRect();\\n      tooltip.style.left = `${rect.left}px`;\\n      tooltip.style.top = `${rect.bottom + 10}px`;\\n      \\n      // 确保提示框不超出屏幕\\n      setTimeout(() => {\\n        const tooltipRect = tooltip.getBoundingClientRect();\\n        if (tooltipRect.right > window.innerWidth) {\\n          tooltip.style.left = `${window.innerWidth - tooltipRect.width - 20}px`;\\n        }\\n        if (tooltipRect.bottom > window.innerHeight) {\\n          tooltip.style.top = `${rect.top - tooltipRect.height - 10}px`;\\n        }\\n      }, 0);\\n      \\n      tooltip.classList.add('show');\\n      currentTooltip = tooltip;\\n    };\\n\\n    // 隐藏物品详情\\n    window.hideItemTooltip = function() {\\n      if (currentTooltip) {\\n        currentTooltip.classList.remove('show');\\n        currentTooltip = null;\\n      }\\n    };\\n\\n    // 点击其他地方隐藏提示框\\n    document.addEventListener('click', (e) => {\\n      if (!e.target.closest('.item-card') && !e.target.closest('.item-tooltip')) {\\n        hideItemTooltip();\\n      }\\n    });\\n\\n    // 处理物品使用（改为打开多选界面）\\n    window.handleItemUse = async function(category, itemName) {\\n      showItemUseModal();\\n    };\\n    \\n    // 显示物品使用多选界面\\n    window.showItemUseModal = function() {\\n      if (!mvuAvailable) {\\n        showNotification('❌ 系统未就绪', 'error');\\n        return;\\n      }\\n      \\n      const all_variables = getAllVariables();\\n      const inventoryCategories = ['消耗品'];\\n      \\n      let itemsHtml = '';\\n      inventoryCategories.forEach(category => {\\n        const items = _.get(all_variables, `stat_data.物品栏.${category}`, {});\\n        for (const itemName in items) {\\n          const item = items[itemName];\\n          if (item && typeof item === 'object') {\\n            const getValue = (val) => Array.isArray(val) ? val[0] : val;\\n            const quantity = getValue(item.数量 || 0);\\n            const effect = getValue(item.效果 || '无效果');\\n            \\n            if (quantity > 0) {\\n              itemsHtml += `\\n                <div class=\\\"select-item\\\" onclick=\\\"toggleItemSelection('${category}', '${itemName}')\\\">\\n                  <input type=\\\"checkbox\\\" class=\\\"select-checkbox\\\" id=\\\"use-${category}-${itemName}\\\" />\\n                  <div class=\\\"select-info\\\">\\n                    <div class=\\\"select-name\\\">${itemName}</div>\\n                    <div class=\\\"select-detail\\\">数量: ${quantity} | 效果: ${effect}</div>\\n                  </div>\\n                </div>\\n              `;\\n            }\\n          }\\n        }\\n      });\\n      \\n      const modalHtml = `\\n        <div class=\\\"modal-overlay show\\\" onclick=\\\"closeItemUseModal()\\\"></div>\\n        <div class=\\\"multi-select-modal show\\\">\\n          <div class=\\\"modal-header\\\">\\n            选择要使用的物品\\n            <span class=\\\"modal-close\\\" onclick=\\\"closeItemUseModal()\\\">×</span>\\n          </div>\\n          <div class=\\\"modal-body\\\">\\n            ${itemsHtml || '<p style=\\\"text-align:center; color: var(--text-light);\\\">暂无可用物品</p>'}\\n          </div>\\n          <div class=\\\"modal-footer\\\">\\n            <div class=\\\"total-info\\\">已选择: <span id=\\\"selected-items-count\\\">0</span> 个物品</div>\\n            <div class=\\\"modal-buttons\\\">\\n              <button class=\\\"modal-btn cancel\\\" onclick=\\\"closeItemUseModal()\\\">取消</button>\\n              <button class=\\\"modal-btn confirm\\\" onclick=\\\"confirmItemUse()\\\">确认使用</button>\\n            </div>\\n          </div>\\n        </div>\\n      `;\\n      \\n      // 添加到页面\\n      const modalContainer = document.createElement('div');\\n      modalContainer.id = 'item-use-modal';\\n      modalContainer.innerHTML = modalHtml;\\n      document.body.appendChild(modalContainer);\\n      \\n      selectedInventoryItems = {};\\n    };\\n    \\n    // 切换物品选择状态\\n    window.toggleItemSelection = function(category, itemName) {\\n      const key = `${category}-${itemName}`;\\n      const checkbox = document.getElementById(`use-${key}`);\\n      \\n      if (selectedInventoryItems[key]) {\\n        delete selectedInventoryItems[key];\\n        checkbox.checked = false;\\n      } else {\\n        selectedInventoryItems[key] = { category, itemName };\\n        checkbox.checked = true;\\n      }\\n      \\n      // 更新选中数量\\n      document.getElementById('selected-items-count').textContent = Object.keys(selectedInventoryItems).length;\\n    };\\n    \\n    // 关闭物品使用界面\\n    window.closeItemUseModal = function() {\\n      const modal = document.getElementById('item-use-modal');\\n      if (modal) {\\n        modal.remove();\\n      }\\n      selectedInventoryItems = {};\\n    };\\n    \\n    // 确认使用物品\\n    window.confirmItemUse = async function() {\\n      const selectedCount = Object.keys(selectedInventoryItems).length;\\n      if (selectedCount === 0) {\\n        showNotification('❌ 请至少选择一个物品', 'error');\\n        return;\\n      }\\n      \\n      try {\\n        const all_variables = getAllVariables();\\n        let useScript = `// 批量使用物品\\\\n`;\\n        let usedItems = [];\\n        let totalEffects = [];\\n        \\n        for (const key in selectedInventoryItems) {\\n          const { category, itemName } = selectedInventoryItems[key];\\n          const item = _.get(all_variables, `stat_data.物品栏.${category}.${itemName}`);\\n          \\n          if (item) {\\n            const getValue = (val) => Array.isArray(val) ? val[0] : val;\\n            const quantity = getValue(item.数量 || 0);\\n            const effect = getValue(item.效果 || '无效果');\\n            \\n            if (quantity > 0) {\\n              usedItems.push(itemName);\\n              totalEffects.push(`${itemName}（${effect}）`);\\n              \\n              // 解析效果\\n              if (effect.includes('恢复体力')) {\\n                const match = effect.match(/恢复体力[+＋]?(\\\\d+)/);\\n                if (match) {\\n                  useScript += `_.add('末希娅.体力值[0]', ${match[1]});\\\\n`;\\n                }\\n              }\\n              \\n              if (effect.includes('精神负担')) {\\n                const match = effect.match(/精神负担[-－](\\\\d+)/);\\n                if (match) {\\n                  useScript += `_.add('末希娅.精神负担[0]', -${match[1]});\\\\n`;\\n                }\\n              }\\n              \\n              if (effect.includes('好感')) {\\n                const match = effect.match(/[增加+＋](\\\\d+)[点]?好感/);\\n                if (match) {\\n                  useScript += `_.add('末希娅.好感度[0]', ${match[1]});\\\\n`;\\n                }\\n              }\\n              \\n              // 减少物品数量\\n              if (quantity > 1) {\\n                useScript += `_.add('物品栏.${category}.${itemName}.数量[0]', -1);\\\\n`;\\n              } else {\\n                useScript += `_.remove('物品栏.${category}', '${itemName}');\\\\n`;\\n              }\\n            }\\n          }\\n        }\\n        \\n        if (usedItems.length > 0) {\\n          // 执行MVU更新\\n          const mvuData = Mvu.getMvuData({ type: 'chat' });\\n          const newData = await Mvu.parseMessage(useScript, mvuData);\\n          \\n          if (newData) {\\n            await Mvu.replaceMvuData(newData, { type: 'chat' });\\n            \\n            // 发送消息到聊天\\n            if (typeof triggerSlash === 'function') {\\n              const itemMessages = [];\\n              for (const effect of totalEffects) {\\n                itemMessages.push(`使用了${effect}`);\\n              }\\n              const message = itemMessages.join('，');\\n              const command = `/send ${message} || /trigger`;\\n              triggerSlash(command);\\n            }\\n            \\n            showNotification(`✅ 成功使用 ${usedItems.length} 个物品！`, 'success');\\n            closeItemUseModal();\\n          } else {\\n            showNotification('❌ 使用失败', 'error');\\n          }\\n        }\\n      } catch (error) {\\n        console.error('批量使用物品失败:', error);\\n        showNotification(`❌ 使用失败: ${error.message}`, 'error');\\n      }\\n    };\\n\\n    // 处理购买（改为打开多选界面）\\n    window.handleBuy = async function(shopName, itemKey) {\\n      showShopModal(shopName);\\n    };\\n    \\n    // 显示商店多选界面\\n    window.showShopModal = function(shopName) {\\n      if (!mvuAvailable) {\\n        showNotification('❌ 系统未就绪', 'error');\\n        return;\\n      }\\n      \\n      const all_variables = getAllVariables();\\n      const goods = _.get(all_variables, `stat_data.商店系统.${shopName}.当前商品列表`, {});\\n      const currentGold = getValue(all_variables, 'stat_data.经济状况.金币', 0);\\n      \\n      let itemsHtml = '';\\n      for (const key in goods) {\\n        const item = goods[key];\\n        if (item && typeof item === 'object' && item.名称) {\\n          const getValue = (val) => Array.isArray(val) ? val[0] : val;\\n          \\n          const itemName = getValue(item.名称);\\n          const price = getValue(item.标价 || 0);\\n          const stock = getValue(item.数量 || 0);\\n          const effect = getValue(item.效果 || item.真实效果 || item.阅读效果 || item.隐藏效果 || '效果未知');\\n          \\n          if (stock > 0) {\\n            itemsHtml += `\\n              <div class=\\\"select-item\\\" onclick=\\\"toggleShopSelection('${shopName}', '${key}', ${price})\\\">\\n                <input type=\\\"checkbox\\\" class=\\\"select-checkbox\\\" id=\\\"buy-${shopName}-${key}\\\" />\\n                <div class=\\\"select-info\\\">\\n                  <div class=\\\"select-name\\\">${itemName}</div>\\n                  <div class=\\\"select-detail\\\">💰 ${price} 金币 | 库存: ${stock} | ${effect}</div>\\n                </div>\\n              </div>\\n            `;\\n          }\\n        }\\n      }\\n      \\n      const modalHtml = `\\n        <div class=\\\"modal-overlay show\\\" onclick=\\\"closeShopModal()\\\"></div>\\n        <div class=\\\"multi-select-modal show\\\">\\n          <div class=\\\"modal-header\\\">\\n            ${shopName} - 选择商品\\n            <span class=\\\"modal-close\\\" onclick=\\\"closeShopModal()\\\">×</span>\\n          </div>\\n          <div class=\\\"modal-body\\\">\\n            ${itemsHtml || '<p style=\\\"text-align:center; color: var(--text-light);\\\">暂无商品</p>'}\\n          </div>\\n          <div class=\\\"modal-footer\\\">\\n            <div class=\\\"total-info\\\">\\n              当前金币: ${currentGold} | 总价: <span id=\\\"total-price\\\">0</span> 金币\\n            </div>\\n            <div class=\\\"modal-buttons\\\">\\n              <button class=\\\"modal-btn cancel\\\" onclick=\\\"closeShopModal()\\\">取消</button>\\n              <button class=\\\"modal-btn confirm\\\" onclick=\\\"confirmShopPurchase('${shopName}')\\\">确认购买</button>\\n            </div>\\n          </div>\\n        </div>\\n      `;\\n      \\n      // 添加到页面\\n      const modalContainer = document.createElement('div');\\n      modalContainer.id = 'shop-modal';\\n      modalContainer.innerHTML = modalHtml;\\n      document.body.appendChild(modalContainer);\\n      \\n      selectedShopItems = {};\\n    };\\n    \\n    // 切换商品选择状态\\n    window.toggleShopSelection = function(shopName, itemKey, price) {\\n      const key = `${shopName}-${itemKey}`;\\n      const checkbox = document.getElementById(`buy-${key}`);\\n      \\n      if (selectedShopItems[key]) {\\n        delete selectedShopItems[key];\\n        checkbox.checked = false;\\n      } else {\\n        selectedShopItems[key] = { shopName, itemKey, price };\\n        checkbox.checked = true;\\n      }\\n      \\n      // 计算总价\\n      let totalPrice = 0;\\n      for (const item in selectedShopItems) {\\n        totalPrice += selectedShopItems[item].price;\\n      }\\n      document.getElementById('total-price').textContent = totalPrice;\\n    };\\n    \\n    // 关闭商店界面\\n    window.closeShopModal = function() {\\n      const modal = document.getElementById('shop-modal');\\n      if (modal) {\\n        modal.remove();\\n      }\\n      selectedShopItems = {};\\n    };\\n    \\n    // 确认购买商品\\n    window.confirmShopPurchase = async function(shopName) {\\n      const selectedCount = Object.keys(selectedShopItems).length;\\n      if (selectedCount === 0) {\\n        showNotification('❌ 请至少选择一个商品', 'error');\\n        return;\\n      }\\n      \\n      try {\\n        const all_variables = getAllVariables();\\n        const currentGold = getValue(all_variables, 'stat_data.经济状况.金币', 0);\\n        \\n        // 计算总价\\n        let totalPrice = 0;\\n        for (const item in selectedShopItems) {\\n          totalPrice += selectedShopItems[item].price;\\n        }\\n        \\n        if (currentGold < totalPrice) {\\n          showNotification(`❌ 金币不足！需要 ${totalPrice} 金币`, 'error');\\n          return;\\n        }\\n        \\n        let buyScript = `// 批量购买商品\\\\n`;\\n        let purchasedItems = [];\\n        \\n        // 扣除金币\\n        buyScript += `_.add('经济状况.金币[0]', -${totalPrice});\\\\n`;\\n        \\n        for (const key in selectedShopItems) {\\n          const { shopName, itemKey } = selectedShopItems[key];\\n          const item = _.get(all_variables, `stat_data.商店系统.${shopName}.当前商品列表.${itemKey}`);\\n          \\n          if (item) {\\n            const getValue = (val) => Array.isArray(val) ? val[0] : val;\\n            const itemName = getValue(item.名称);\\n            const stock = getValue(item.数量);\\n            const quality = getValue(item.品质 || item.实际品质) || '普通';\\n            const effect = getValue(item.效果 || item.真实效果 || item.阅读效果 || item.隐藏效果) || '效果未知';\\n            \\n            purchasedItems.push(itemName);\\n            \\n            // 减少库存\\n            buyScript += `_.add('商店系统.${shopName}.当前商品列表.${itemKey}.数量[0]', -1);\\\\n`;\\n            \\n            // 根据商店类型添加到对应物品栏\\n            if (shopName === '麦香庭') {\\n              const existingItem = _.get(all_variables, `stat_data.物品栏.消耗品.${itemName}`);\\n              if (existingItem) {\\n                buyScript += `_.add('物品栏.消耗品.${itemName}.数量[0]', 1);\\\\n`;\\n              } else {\\n                buyScript += `_.assign('物品栏.消耗品', '${itemName}', {\\n  \\\"数量\\\": [1, \\\"持有数量\\\"],\\n  \\\"品质\\\": [\\\"${quality}\\\", \\\"物品品质\\\"],\\n  \\\"效果\\\": [\\\"${effect}\\\", \\\"使用效果\\\"]\\n});\\\\n`;\\n              }\\n            } else if (shopName === '尘封书页') {\\n              buyScript += `_.assign('物品栏.书籍文献', '${itemName}', {\\n  \\\"数量\\\": [1, \\\"持有数量\\\"],\\n  \\\"状态\\\": [\\\"完好\\\", \\\"物品状态\\\"],\\n  \\\"效果\\\": [\\\"${effect}\\\", \\\"阅读效果\\\"]\\n});\\\\n`;\\n            } else if (shopName === '花语秘境') {\\n              buyScript += `_.assign('物品栏.特殊物品', '${itemName}', {\\n  \\\"数量\\\": [1, \\\"持有数量\\\"],\\n  \\\"描述\\\": [\\\"${effect}\\\", \\\"物品描述\\\"],\\n  \\\"效果\\\": [\\\"${effect}\\\", \\\"特殊效果\\\"]\\n});\\\\n`;\\n            }\\n            \\n            // 如果售罄则移除\\n            if (stock - 1 <= 0) {\\n              buyScript += `_.remove('商店系统.${shopName}.当前商品列表', '${itemKey}');\\\\n`;\\n            }\\n          }\\n        }\\n        \\n        // 增加店主好感\\n        const npcMap = {\\n          '麦香庭': '玛莎',\\n          '尘封书页': '巴纳比',\\n          '花语秘境': '艾丽丝'\\n        };\\n        const npcName = npcMap[shopName];\\n        const addValue = (shopName === '花语秘境' ? 2 : 1) * selectedCount;\\n        buyScript += `_.add('NPC亲密度.${npcName}.亲密度[0]', ${addValue});`;\\n        \\n        // 执行MVU更新\\n        const mvuData = Mvu.getMvuData({ type: 'chat' });\\n        const newData = await Mvu.parseMessage(buyScript, mvuData);\\n        \\n        if (newData) {\\n          await Mvu.replaceMvuData(newData, { type: 'chat' });\\n\\n        // 发送消息到聊天\\n       if (typeof triggerSlash === 'function') {\\n       const itemsList = purchasedItems.join('、');\\n       const message = `在${shopName}购买了: ${itemsList}，花费了${totalPrice}金币`;\\n       const command = `/send ${message} || /trigger`;\\n       triggerSlash(command);\\n        }\\n          \\n          showNotification(`✅ 购买成功！花费 ${totalPrice} 金币`, 'success');\\n          closeShopModal();\\n        } else {\\n          showNotification('❌ 购买处理失败', 'error');\\n        }\\n        \\n      } catch (error) {\\n        console.error('批量购买失败:', error);\\n        showNotification(`❌ 购买失败: ${error.message}`, 'error');\\n      }\\n    };\\n    \\n    // 委托完成处理（优化版：支持自动刷新）\\n    window.completeQuest = async function(questType) {\\n      try {\\n        if (!mvuAvailable) {\\n          showNotification('❌ 系统未就绪', 'error');\\n          return;\\n        }\\n        \\n        const all_variables = getAllVariables();\\n        let questScript = `// 完成委托\\\\n`;\\n        let rewardMessage = '';\\n        \\n        if (questType === 'normal') {\\n          // 普通委托\\n          const rewards = _.get(all_variables, 'stat_data.村民委托.委托奖励', {});\\n          const gold = getValue(rewards, '金币', 0);\\n          const itemName = getValue(rewards, '物品', '');\\n          const reputation = getValue(rewards, '声望', 0);\\n          \\n          if (gold > 0) {\\n            questScript += `_.add('经济状况.金币[0]', ${gold});\\\\n`;\\n            rewardMessage += `金币+${gold} `;\\n          }\\n          \\n          if (itemName && itemName !== '无') {\\n            // 添加奖励物品\\n            questScript += `_.assign('物品栏.任务物品', '${itemName}', {\\n  \\\"数量\\\": [1, \\\"持有数量\\\"],\\n  \\\"描述\\\": [\\\"委托奖励物品\\\", \\\"物品描述\\\"]\\n});\\\\n`;\\n            rewardMessage += `获得${itemName} `;\\n          }\\n          \\n          if (reputation > 0) {\\n            questScript += `_.add('社会地位.声望[0]', ${reputation});\\\\n`;\\n            rewardMessage += `声望+${reputation} `;\\n          }\\n          \\n          // 标记委托为已完成\\n          questScript += `_.set('村民委托.完成状态[0]', '已完成');\\\\n`;\\n          \\n          // 随机生成新委托\\n          const normalQuests = [\\n            {\\n              name: '收集草药',\\n              client: '药剂师艾拉',\\n              content: '收集10株月光草用于制作药剂',\\n              difficulty: 2,\\n              gold: 30,\\n              item: '生命药水',\\n              reputation: 5\\n            },\\n            {\\n              name: '送信任务',\\n              client: '邮差汤姆',\\n              content: '帮忙送一封信到邻镇',\\n              difficulty: 1,\\n              gold: 20,\\n              item: '无',\\n              reputation: 3\\n            },\\n            {\\n              name: '寻找失物',\\n              client: '老奶奶玛丽',\\n              content: '帮忙寻找丢失的项链',\\n              difficulty: 2,\\n              gold: 25,\\n              item: '幸运护符',\\n              reputation: 4\\n            },\\n            {\\n              name: '驱赶野兽',\\n              client: '农夫约翰',\\n              content: '驱赶破坏农田的野兽',\\n              difficulty: 3,\\n              gold: 40,\\n              item: '新鲜水果',\\n              reputation: 6\\n            }\\n          ];\\n          \\n          const newQuest = normalQuests[Math.floor(Math.random() * normalQuests.length)];\\n          questScript += `\\n// 生成新委托\\n_.set('村民委托.当前委托[0]', '${newQuest.name}');\\n_.set('村民委托.委托人[0]', '${newQuest.client}');\\n_.set('村民委托.委托内容[0]', '${newQuest.content}');\\n_.set('村民委托.委托难度[0]', ${newQuest.difficulty});\\n_.set('村民委托.委托奖励.金币[0]', ${newQuest.gold});\\n_.set('村民委托.委托奖励.物品[0]', '${newQuest.item}');\\n_.set('村民委托.委托奖励.声望[0]', ${newQuest.reputation});\\n_.set('村民委托.完成状态[0]', '进行中');`;\\n          \\n        } else if (questType === 'special') {\\n          // 专属委托\\n          const specialGold = getValue(all_variables, 'stat_data.村民委托.末希娅专属委托.金币奖励', 0);\\n          \\n          questScript += `_.add('经济状况.金币[0]', ${specialGold});\\\\n`;\\n          questScript += `_.add('末希娅.精神负担[0]', 10);\\\\n`; // 增加道德负担\\n          rewardMessage = `金币+${specialGold}，但精神负担增加`;\\n          \\n          // 标记专属委托为已完成\\n          questScript += `_.set('村民委托.末希娅专属委托.完成状态[0]', '已完成');\\\\n`;\\n          \\n          // 随机生成新的专属委托\\n          const specialQuests = [\\n            {\\n              name: '死而复生',\\n              client: '贵族小姐艾琳',\\n              content: '艾琳姐姐最喜欢的植物死了，希望圣女可以复活它。',\\n              gold: 100\\n            },\\n            {\\n              name: '命悬一线',\\n              client: '牧羊人伊贝尔',\\n              content: '伊贝尔五岁的孩子碰了一颗有毒的植物昏迷了，能帮帮他吗？',\\n              gold: 80\\n            },\\n            {\\n              name: '会说话的植物',\\n              client: '生物学家乔森',\\n              content: '听说出现了一株会说话的奇特植物，您能帮我找到吗？',\\n              gold: 60\\n            },\\n            {\\n              name: '暗中交易',\\n              client: '走私者',\\n              content: '协助运送一批需要特殊环境生存的植物',\\n              gold: 120\\n            }\\n          ];\\n          \\n          const newSpecial = specialQuests[Math.floor(Math.random() * specialQuests.length)];\\n          questScript += `\\n// 生成新专属委托\\n_.set('村民委托.末希娅专属委托.当前专属[0]', '${newSpecial.name}');\\n_.set('村民委托.末希娅专属委托.委托人[0]', '${newSpecial.client}');\\n_.set('村民委托.末希娅专属委托.委托内容[0]', '${newSpecial.content}');\\n_.set('村民委托.末希娅专属委托.金币奖励[0]', ${newSpecial.gold});\\n_.set('村民委托.末希娅专属委托.完成状态[0]', '进行中');`;\\n        }\\n        \\n        // 执行MVU更新\\n        const mvuData = Mvu.getMvuData({ type: 'chat' });\\n        const newData = await Mvu.parseMessage(questScript, mvuData);\\n        \\n        if (newData) {\\n          await Mvu.replaceMvuData(newData, { type: 'chat' });\\n          \\n          // 发送触发命令\\n          const message = `完成了委托！${rewardMessage}`;\\n          triggerSlash(message);\\n          \\n          showNotification(`✅ 委托完成！${rewardMessage}`, 'success');\\n        } else {\\n          showNotification('❌ 委托完成处理失败', 'error');\\n        }\\n        \\n      } catch (error) {\\n        console.error('委托完成失败:', error);\\n        showNotification(`❌ 委托完成失败: ${error.message}`, 'error');\\n      }\\n    };\\n    \\n    // 新增：刷新委托功能\\n    window.refreshQuest = async function(questType) {\\n      try {\\n        if (!mvuAvailable) {\\n          showNotification('❌ 系统未就绪', 'error');\\n          return;\\n        }\\n        \\n        const all_variables = getAllVariables();\\n        \\n        // 检查委托是否已完成\\n        const isCompleted = questType === 'normal'\\n          ? getValue(all_variables, 'stat_data.村民委托.完成状态', '进行中') === '已完成'\\n          : getValue(all_variables, 'stat_data.村民委托.末希娅专属委托.完成状态', '进行中') === '已完成';\\n        \\n        if (!isCompleted) {\\n          showNotification('❌ 请先完成当前委托', 'error');\\n          return;\\n        }\\n        \\n        let refreshScript = `// 刷新委托\\\\n`;\\n        \\n        if (questType === 'normal') {\\n          // 刷新普通委托\\n          const normalQuests = [\\n            {\\n              name: '巡逻任务',\\n              client: '卫队长',\\n              content: '协助巡逻镇子周边',\\n              difficulty: 2,\\n              gold: 35,\\n              item: '守卫勋章',\\n              reputation: 5\\n            },\\n            {\\n              name: '清理仓库',\\n              client: '仓库管理员',\\n              content: '帮忙整理杂乱的仓库',\\n              difficulty: 1,\\n              gold: 15,\\n              item: '无',\\n              reputation: 2\\n            },\\n            {\\n              name: '采集材料',\\n              client: '铁匠',\\n              content: '收集制作武器的材料',\\n              difficulty: 3,\\n              gold: 45,\\n              item: '精铁矿石',\\n              reputation: 7\\n            }\\n          ];\\n          \\n          const newQuest = normalQuests[Math.floor(Math.random() * normalQuests.length)];\\n          refreshScript += `\\n_.set('村民委托.当前委托[0]', '${newQuest.name}');\\n_.set('村民委托.委托人[0]', '${newQuest.client}');\\n_.set('村民委托.委托内容[0]', '${newQuest.content}');\\n_.set('村民委托.委托难度[0]', ${newQuest.difficulty});\\n_.set('村民委托.委托奖励.金币[0]', ${newQuest.gold});\\n_.set('村民委托.委托奖励.物品[0]', '${newQuest.item}');\\n_.set('村民委托.委托奖励.声望[0]', ${newQuest.reputation});\\n_.set('村民委托.完成状态[0]', '进行中');`;\\n          \\n        } else {\\n          // 刷新专属委托\\n          const specialQuests = [\\n            {\\n              name: '刺探情报',\\n              client: '间谍头目',\\n              content: '潜入贵族聚会刺探情报',\\n              gold: 90\\n            },\\n            {\\n              name: '破坏证据',\\n              client: '腐败官员',\\n              content: '销毁对某人不利的证据',\\n              gold: 110\\n            }\\n          ];\\n          \\n          const newSpecial = specialQuests[Math.floor(Math.random() * specialQuests.length)];\\n          refreshScript += `\\n_.set('村民委托.末希娅专属委托.当前专属[0]', '${newSpecial.name}');\\n_.set('村民委托.末希娅专属委托.委托人[0]', '${newSpecial.client}');\\n_.set('村民委托.末希娅专属委托.委托内容[0]', '${newSpecial.content}');\\n_.set('村民委托.末希娅专属委托.金币奖励[0]', ${newSpecial.gold});\\n_.set('村民委托.末希娅专属委托.完成状态[0]', '进行中');`;\\n        }\\n        \\n        // 执行MVU更新\\n        const mvuData = Mvu.getMvuData({ type: 'chat' });\\n        const newData = await Mvu.parseMessage(refreshScript, mvuData);\\n        \\n        if (newData) {\\n          await Mvu.replaceMvuData(newData, { type: 'chat' });\\n          showNotification(`✅ 委托已刷新！`, 'success');\\n        } else {\\n          showNotification('❌ 刷新失败', 'error');\\n        }\\n        \\n      } catch (error) {\\n        console.error('刷新委托失败:', error);\\n        showNotification(`❌ 刷新失败: ${error.message}`, 'error');\\n      }\\n    };\\n\\n    // 获取值的辅助函数\\n    function getValue(obj, path, defaultValue = 'N/A') {\\n      const result = _.get(obj, path, defaultValue);\\n      if (Array.isArray(result) && result.length >= 1) {\\n        return result[0];\\n      }\\n      return result;\\n    }\\n\\n    // 获取物品稀有度星级\\n    function getRarityStars(quality) {\\n      const rarityMap = {\\n        '劣质': 1,\\n        '普通': 2,\\n        '良好': 3,\\n        '优秀': 4,\\n        '完美': 5\\n      };\\n      const stars = rarityMap[quality] || 2;\\n      return '⭐'.repeat(stars);\\n    }\\n\\n    // 渲染物品格子\\n    function renderInventoryGrid(items, category) {\\n      const slots = [];\\n      \\n      for (const itemName in items) {\\n        const item = items[itemName];\\n        if (item && typeof item === 'object') {\\n          const getValue = (val) => Array.isArray(val) ? val[0] : val;\\n          const quantity = getValue(item.数量);\\n          const quality = getValue(item.品质) || '普通';\\n          \\n          const icon = category === '消耗品' ? '🍞' : \\n                      category === '书籍文献' ? '📖' : \\n                      category === '特殊物品' ? '✨' : '📦';\\n          \\n          slots.push(`\\n            <div class=\\\"item-card has-item\\\" onclick=\\\"showItemTooltip(event, '${itemName}', '${category}')\\\">\\n              ${quantity > 1 ? `<span class=\\\"item-quantity\\\">${quantity}</span>` : ''}\\n              <div class=\\\"item-icon\\\">${icon}</div>\\n              <div class=\\\"item-name\\\">${itemName}</div>\\n              <div class=\\\"item-rarity\\\">${getRarityStars(quality)}</div>\\n            </div>\\n          `);\\n        }\\n      }\\n      \\n      // 添加一些空格子\\n      const emptySlots = Math.max(0, 8 - slots.length);\\n      for (let i = 0; i < emptySlots; i++) {\\n        slots.push('<div class=\\\"item-card\\\"></div>');\\n      }\\n      \\n      return slots.join('');\\n    }\\n\\n    // 渲染商店商品\\n    function renderShopItems(goods, shopName) {\\n      if (!goods || typeof goods !== 'object') return '<div style=\\\"text-align: center; color: var(--text-light); padding: 20px;\\\">暂无商品</div>';\\n      \\n      const items = [];\\n      const shopIcons = {\\n        '麦香庭': '🍞',\\n        '尘封书页': '📖',\\n        '花语秘境': '🌼'\\n      };\\n      \\n      for (const key in goods) {\\n        const item = goods[key];\\n        if (item && typeof item === 'object' && item.名称) {\\n          const getValue = (val) => Array.isArray(val) ? val[0] : val;\\n          \\n          const itemName = getValue(item.名称);\\n          const price = getValue(item.标价 || 0);\\n          const stock = getValue(item.数量 || 0);\\n          const effect = getValue(item.效果 || item.真实效果 || item.阅读效果 || item.隐藏效果 || '效果未知');\\n          \\n          items.push(`\\n            <div class=\\\"shop-card\\\">\\n              <div class=\\\"shop-image\\\">${shopIcons[shopName] || '🛍️'}</div>\\n              <div class=\\\"shop-details\\\">\\n                <div class=\\\"shop-name\\\">${itemName}</div>\\n                <div class=\\\"shop-description\\\">${effect}</div>\\n                <div class=\\\"shop-footer\\\">\\n                  <div class=\\\"shop-price\\\">💰 ${price}</div>\\n                  <div class=\\\"shop-price\\\">库存: ${stock}</div>\\n                </div>\\n              </div>\\n            </div>\\n          `);\\n        }\\n      }\\n      \\n      return items.length > 0 ? items.join('') : '<div style=\\\"text-align: center; color: var(--text-light); padding: 20px;\\\">暂无商品</div>';\\n    }\\n\\n    // 主数据填充函数\\n    function populateData() {\\n      try {\\n        if (!mvuAvailable) {\\n          return;\\n        }\\n\\n        // 使用 getAllVariables() 获取完整变量对象\\n        const all_variables = getAllVariables();\\n        \\n        // 顶部资源\\n        document.getElementById('gold-value').textContent = getValue(all_variables, 'stat_data.经济状况.金币', 0);\\n        document.getElementById('stamina-value').textContent = getValue(all_variables, 'stat_data.末希娅.体力值', 0);\\n        document.getElementById('affection-value').textContent = getValue(all_variables, 'stat_data.末希娅.好感度', 0);\\n        \\n        // 角色信息\\n        document.getElementById('character-name').textContent = '末希娅';\\n        const duty = getValue(all_variables, 'stat_data.末希娅.圣女职责压力', 0);\\n        const mental = getValue(all_variables, 'stat_data.末希娅.精神负担', 0);\\n        const reputation = getValue(all_variables, 'stat_data.社会地位.声望', 0);\\n        \\n        document.getElementById('hp-value').textContent = `${duty}/100`;\\n        document.getElementById('hp-fill').style.width = `${Math.min(duty, 100)}%`;\\n        \\n        document.getElementById('mp-value').textContent = `${100 - mental}/100`;\\n        document.getElementById('mp-fill').style.